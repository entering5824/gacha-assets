# Copy variable NAMES to your local .env. Keep secrets out of source control.
SUPABASE_URL=
SUPABASE_BUCKET=GachaCounter
SUPABASE_STORAGE_API_KEY=
# Alternatives: SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=
# Optional; defaults to MONGODB_COLLECTION + _releases
MONGODB_RELEASE_COLLECTION=
